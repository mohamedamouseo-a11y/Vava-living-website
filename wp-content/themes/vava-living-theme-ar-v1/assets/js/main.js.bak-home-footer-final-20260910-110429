    {when:"ready", fn:function(){
    
    const introLoader = document.querySelector('.intro-loader');
    try {
      if (document.documentElement.classList.contains('intro-seen')) {
        if (introLoader) introLoader.remove();
      } else if (introLoader) {
        introLoader.addEventListener('animationend', function(event){
          if (event.target === introLoader && event.animationName === 'introOut') {
            introLoader.remove();
          }
        });
        setTimeout(function(){ if (introLoader && introLoader.parentNode) introLoader.remove(); }, 6800);
      }
    } catch (e) {}

    const stage = document.getElementById('stage');
    const sections = [...document.querySelectorAll('.section')];
    const links = [...document.querySelectorAll('[data-go]')];
    const navLinks = [...document.querySelectorAll('nav a[data-go]')];
    const progress = document.getElementById('progress');
    const header = document.getElementById('header');
    const burger = document.getElementById('burger');
    const nav = document.getElementById('nav');
    let index = 0;
    let locked = false;
    let startY = 0;

    sections.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === 0 ? ' active' : '');
      dot.type = 'button';
      dot.setAttribute('aria-label', 'Go to section ' + (i + 1));
      dot.addEventListener('click', () => goTo(i));
      progress.appendChild(dot);
    });
    const dots = [...document.querySelectorAll('.dot')];

    function goTo(i){
      if(i < 0 || i >= sections.length || i === index || locked) return;
      locked = true;
      index = i;
      stage.style.transform = `translateY(-${index * 100}svh)`;
      sections.forEach((s, n) => s.classList.toggle('active', n === index));
      dots.forEach((d, n) => d.classList.toggle('active', n === index));
      navLinks.forEach(a => a.classList.toggle('active', Number(a.dataset.go) === index));
      header.classList.toggle('compact', index > 0);
      const scrollCue = document.getElementById('scrollCue');
      if (scrollCue) scrollCue.classList.toggle('is-hidden', index >= sections.length - 1);
      nav.classList.remove('open');
      setTimeout(() => locked = false, 1120);
    }

    window.addEventListener('wheel', (e) => {
      e.preventDefault();
      if(Math.abs(e.deltaY) < 18) return;
      goTo(index + (e.deltaY > 0 ? 1 : -1));
    }, {passive:false});

    window.addEventListener('keydown', (e) => {
      if(['ArrowDown','PageDown',' '].includes(e.key)) goTo(index + 1);
      if(['ArrowUp','PageUp'].includes(e.key)) goTo(index - 1);
      if(e.key === 'Home') goTo(0);
      if(e.key === 'End') goTo(sections.length - 1);
    });

    window.addEventListener('touchstart', (e) => startY = e.touches[0].clientY, {passive:true});
    window.addEventListener('touchmove', (e) => {
      const diff = startY - e.touches[0].clientY;
      if(Math.abs(diff) > 58){
        goTo(index + (diff > 0 ? 1 : -1));
        startY = e.touches[0].clientY;
      }
    }, {passive:true});

    links.forEach(link => link.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(Number(link.dataset.go));
    }));

    burger.addEventListener('click', () => nav.classList.toggle('open'));

    const heroVideo = document.querySelector('.hero-video');
    if (heroVideo) {
      heroVideo.muted = true;
      heroVideo.playsInline = true;
      const tryPlay = () => heroVideo.play().catch(() => {});
      window.addEventListener('load', tryPlay);
      document.addEventListener('click', tryPlay, { once: true });
      document.addEventListener('touchstart', tryPlay, { once: true });
    }
  

