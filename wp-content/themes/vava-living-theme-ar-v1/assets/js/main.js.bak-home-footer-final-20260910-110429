  var track=document.querySelector('.testimonial-track');
  if(!track) return;
  var prev=document.querySelector('.testimonial-arrow.prev');
  var next=document.querySelector('.testimonial-arrow.next');
  var dotsWrap=document.querySelector('.testimonial-dots');
  var thumbsWrap=document.querySelector('.testimonial-thumbnails');
  var slides=[].slice.call(track.children);
  var thumbs=thumbsWrap ? [].slice.call(thumbsWrap.querySelectorAll('[data-testimonial-index]')) : [];
  var page=0;
  function maxPage(){ return Math.max(0, slides.length - 1); }
  function buildDots(){
    if(!dotsWrap) return;
    dotsWrap.innerHTML='';
    slides.forEach(function(_, index){
      var dot=document.createElement('button');
      dot.type='button';
      dot.className='testimonial-dot' + (index===page?' active':'');
      dot.setAttribute('aria-label',(document.documentElement.lang==='en'?'Show story ':'عرض التجربة ') + (index+1));
      dot.addEventListener('click',function(){ page=index; update(); });
      dotsWrap.appendChild(dot);
    });
  }
  thumbs.forEach(function(thumb,index){
    thumb.addEventListener('click',function(){ page=index; update(); });
  });
  function update(){
    page=Math.max(0,Math.min(page,maxPage()));
    var first=slides[0];
    var gap=parseFloat(getComputedStyle(track).gap || 0);
    var width=first ? first.getBoundingClientRect().width : 0;
    track.style.transform='translateX(-' + (page * (width + gap)) + 'px)';
    var activeSlide=slides[page];
    var viewport=track.parentElement;
    if(activeSlide && viewport){
      var viewportStyle=getComputedStyle(viewport);
      var paddingTop=parseFloat(viewportStyle.paddingTop || 0);
      var paddingBottom=parseFloat(viewportStyle.paddingBottom || 0);
      viewport.style.height=(activeSlide.offsetHeight + paddingTop + paddingBottom) + 'px';
    }
    slides.forEach(function(slide,index){
      slide.classList.toggle('active',index===page);
      slide.setAttribute('aria-hidden',index===page?'false':'true');
    });
    if(dotsWrap){ [].slice.call(dotsWrap.children).forEach(function(dot,index){ dot.classList.toggle('active',index===page); }); }
    thumbs.forEach(function(thumb,index){
      thumb.classList.toggle('active',index===page);
      thumb.setAttribute('aria-pressed',index===page?'true':'false');
    });
  }
  if(prev) prev.addEventListener('click',function(){ page=page<=0?maxPage():page-1; update(); });
  if(next) next.addEventListener('click',function(){ page=page>=maxPage()?0:page+1; update(); });
  window.addEventListener('resize',update);
  buildDots();
  update();
})();

