    if(navType !== 'reload' && (fromLangParam || fromInternalParam || fromInternalSession || cameFromInternalPage)){
      document.documentElement.classList.add('intro-seen');
    }

    if((fromInternalParam || fromLangParam) && window.history && window.history.replaceState){
      var cleanUrl = window.location.pathname + (window.location.hash || '');
      window.history.replaceState(null, document.title, cleanUrl);
    }
  }catch(e){}
})();
