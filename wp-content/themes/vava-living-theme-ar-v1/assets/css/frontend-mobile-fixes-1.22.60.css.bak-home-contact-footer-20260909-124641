/**
 * VAVA Living 1.22.60 — mobile horizontal overflow guard.
 * Scope: frontend only. Keep intentional vertical/section scrolling intact.
 */

/* Prevent off-canvas decoration/transforms from widening the viewport. */
html,
body.vava-homepage,
body.vava-internal-page {
  max-width: 100%;
  overflow-x: clip !important;
}

@supports not (overflow: clip) {
  html,
  body.vava-homepage,
  body.vava-internal-page {
    overflow-x: hidden !important;
  }
}

@media (max-width: 980px) {
  body.vava-homepage,
  body.vava-internal-page {
    width: 100%;
    max-width: 100vw;
    position: relative;
  }

  body.vava-homepage .app,
  body.vava-homepage .stage,
  body.vava-homepage .section,
  body.vava-internal-page main,
  body.vava-internal-page .section,
  body.vava-internal-page .container,
  body.vava-internal-page .page-shell,
  body.vava-internal-page .footer,
  body.vava-internal-page .page-footer {
    min-width: 0 !important;
    max-width: 100% !important;
  }

  body.vava-homepage img,
  body.vava-homepage video,
  body.vava-homepage canvas,
  body.vava-homepage iframe,
  body.vava-internal-page img,
  body.vava-internal-page video,
  body.vava-internal-page canvas,
  body.vava-internal-page iframe {
    max-width: 100% !important;
  }

  /* Fixed header and mobile menu must always stay inside the viewport. */
  body.vava-homepage .fixed-header,
  body.vava-internal-page .fixed-header {
    max-width: calc(100vw - 20px) !important;
    box-sizing: border-box;
  }

  body.vava-homepage #nav,
  body.vava-internal-page #nav {
    max-width: calc(100vw - 20px) !important;
    box-sizing: border-box;
  }

  /* Decorative shapes are allowed to extend visually, but never the document width. */
  body.vava-homepage .blob,
  body.vava-homepage .leaf,
  body.vava-homepage .journal-organic-shape,
  body.vava-homepage .journal-botanical,
  body.vava-internal-page .blob,
  body.vava-internal-page .leaf {
    pointer-events: none;
  }

  /* Flex/grid children with long text or controls should shrink instead of widening the page. */
  body.vava-homepage .wrap > *,
  body.vava-homepage .single,
  body.vava-homepage .journal-scene > *,
  body.vava-homepage .shop-flow > *,
  body.vava-homepage .contact-card > *,
  body.vava-internal-page main *,
  body.vava-internal-page .section > * {
    min-width: 0;
  }

  /*
   * Phase 02: the shared footer can compute wider than a small viewport when
   * width:100% combines with content-box sizing or the desktop three-column
   * grid. Keep it border-box and single-column so no footer column hangs off
   * either edge on phones. This is the actual overflowing element, not a
   * wholesale page-clipping workaround.
   */
  body.vava-homepage .footer.page-footer,
  body.vava-internal-page .footer.page-footer {
    box-sizing: border-box !important;
    grid-template-columns: 1fr !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
  }
}


/* ===== STAGE 18 HOTFIX v5 — Real mobile overflow fix ===== */

/* Fix contact-v4-frame: 100vw includes scrollbar, use 100% instead */
@media (max-width: 980px) {
  html[data-page="index.html"] .contact-v4-section .contact-v4-frame {
    width: 100% !important;
    max-width: calc(100% - 24px) !important;
    margin-left: auto !important;
    margin-right: auto !important;
    box-sizing: border-box !important;
  }

  /* Contain ornaments within frame bounds */
  html[data-page="index.html"] .contact-v4-section .contact-v4-frame {
    overflow: hidden !important;
  }

  /* Ensure ornaments don't push document width */
  html[data-page="index.html"] .contact-v4-ornament,
  html[data-page="index.html"] .contact-v4-ornament-top-left,
  html[data-page="index.html"] .contact-v4-ornament-bottom-left,
  html[data-page="index.html"] .contact-v4-ornament-right-top,
  html[data-page="index.html"] .contact-v4-ornament-right-bottom {
    max-width: 100% !important;
    left: 0 !important;
    right: auto !important;
  }
  html[data-page="index.html"] .contact-v4-ornament-right-top,
  html[data-page="index.html"] .contact-v4-ornament-right-bottom {
    left: auto !important;
    right: 0 !important;
  }

  /* Contact actions container must not exceed viewport */
  html[data-page="index.html"] .contact-v4-actions {
    max-width: 100% !important;
    width: min(280px, 100%) !important;
    box-sizing: border-box !important;
  }

  /* Footer: force single column and border-box to prevent overflow */
  .footer.page-footer,
  body.vava-homepage .footer.page-footer,
  body.vava-internal-page .footer.page-footer,
  footer.footer.page-footer,
  .page-footer {
    grid-template-columns: 1fr !important;
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    padding-left: clamp(16px, 4vw, 44px) !important;
    padding-right: clamp(16px, 4vw, 44px) !important;
    overflow: visible !important;
  }

  /* Footer children must not force width */
  .footer.page-footer > *,
  .footer.page-footer .footer-logo,
  .footer.page-footer .footer-center,
  .footer.page-footer .social,
  .footer.page-footer .footer-main-links,
  .footer.page-footer .footer-policy-links {
    min-width: 0 !important;
    max-width: 100% !important;
    word-break: break-word !important;
  }

  /* Footer logo image constraint */
  .footer.page-footer .footer-logo img {
    max-width: 100% !important;
    height: auto !important;
  }

  /* Prevent footer center pseudo-elements from extending width */
  .footer.page-footer > .footer-center::before,
  .footer.page-footer > .footer-center::after {
    display: none !important;
  }
}


/* ===== STAGE 18 FINAL ROOT FIX — Testimonial/Blob/Journal containment ===== */
@media (max-width: 980px) {
  /* Testimonial section must contain its carousel track */
  html[data-page="index.html"] .testimonial-section {
    overflow-x: clip !important;
    max-width: 100% !important;
    position: relative !important;
  }
  html[data-page="index.html"] .testimonial-carousel {
    max-width: 100% !important;
    overflow: visible !important;
  }
  html[data-page="index.html"] .testimonial-viewport {
    overflow: hidden !important;
    max-width: 100% !important;
    width: 100% !important;
  }
  html[data-page="index.html"] .testimonial-track {
    max-width: none !important;
    width: auto !important;
  }
  html[data-page="index.html"] .testimonial-slide {
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }
  /* Contain testimonial slide pseudo-elements */
  html[data-page="index.html"] .testimonial-slide::before,
  html[data-page="index.html"] .testimonial-slide::after {
    max-width: 100% !important;
    inset-inline-end: 0 !important;
    right: auto !important;
    left: auto !important;
  }

  /* Journal organic shapes and botanical decorations */
  html[data-page="index.html"] .journal-organic-shape,
  html[data-page="index.html"] .journal-botanical,
  body.vava-homepage .journal-organic-shape,
  body.vava-homepage .journal-botanical {
    max-width: 100% !important;
    overflow: hidden !important;
    left: 0 !important;
    right: auto !important;
  }

  /* Blob decorative elements on index page */
  html[data-page="index.html"] .blob,
  html[data-page="index.html"] .blob.b1,
  html[data-page="index.html"] .blob.b2,
  body.vava-homepage .blob {
    max-width: 100% !important;
    left: 0 !important;
    right: auto !important;
    width: auto !important;
  }

  /* Ensure all sections clip horizontal overflow at container level */
  body.vava-homepage .section,
  body.vava-homepage main > section {
    overflow-x: clip !important;
    max-width: 100% !important;
  }
}


/* ===== HOMEPAGE FOOTER FIX — sections must not clip footer ===== */
/* Root cause: .section retains height:100svh from desktop rule on mobile,
   trapping the footer inside a fixed-height scrollable container. */
@media (max-width: 980px) {
  html[data-page="index.html"] .section,
  body.vava-homepage .section {
    height: auto !important;
    min-height: 0 !important;
    overflow-y: visible !important;
  }

  /* Ensure contact section (which contains footer) has no height constraint */
  html[data-page="index.html"] .contact-section,
  body.vava-homepage .contact-section {
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  /* Footer must be in normal flow on homepage mobile */
  html[data-page="index.html"] .footer,
  html[data-page="index.html"] .footer.page-footer,
  body.vava-homepage .footer,
  body.vava-homepage .footer.page-footer {
    position: relative !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    margin-top: 20px !important;
  }
}
