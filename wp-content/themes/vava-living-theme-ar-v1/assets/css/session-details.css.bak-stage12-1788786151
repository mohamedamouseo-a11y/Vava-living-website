.vava-session-detail{--s-olive:#626840;--s-coral:#d77c5f;--s-ink:#4b493f;--s-line:rgba(99,99,72,.17);padding:46px clamp(20px,5vw,76px) 70px;color:var(--s-ink)}
.vava-session-hero{max-width:1280px;margin:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr) 230px;gap:34px;align-items:center;position:relative}
.vava-session-hero-media{height:450px;border-radius:34px;overflow:hidden;box-shadow:0 28px 70px rgba(70,62,44,.12)}.vava-session-hero-media img{width:100%;height:100%;object-fit:cover}
.vava-session-breadcrumb{display:flex;gap:9px;align-items:center;font-size:12px;color:#898477;margin-bottom:23px}.vava-session-breadcrumb a{color:var(--s-olive);text-decoration:none}.vava-session-eyebrow{display:inline-flex;padding:7px 13px;border-radius:999px;background:rgba(171,166,111,.12);color:var(--s-olive);font-size:12px}.vava-session-hero-copy h1{font-family:"VAVA Display","Noto Kufi Arabic",serif!important;font-size:clamp(42px,4.5vw,66px)!important;line-height:1.25!important;margin:14px 0!important;color:var(--s-olive)!important}.vava-session-lead p{font-size:17px!important;line-height:2!important;color:#686258!important}.vava-session-tags{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.vava-session-tags span{padding:7px 12px;border-radius:999px;background:rgba(171,166,111,.1);font-size:12px;color:#777164}.vava-session-hero-actions{display:flex;gap:12px;flex-wrap:wrap}.vava-session-btn{display:inline-flex;align-items:center;justify-content:center;min-width:190px;padding:14px 24px;border-radius:999px;text-decoration:none;font-weight:700}.vava-session-btn.is-primary{background:var(--s-coral);color:#fff;box-shadow:0 17px 34px rgba(215,124,95,.22)}.vava-session-btn.is-secondary{border:1px solid rgba(98,104,64,.45);color:var(--s-olive);background:rgba(255,255,255,.35)}
.vava-session-facts{border:1px solid var(--s-line);border-radius:28px;padding:18px;background:rgba(255,252,247,.8);box-shadow:0 25px 60px rgba(72,65,50,.09)}.vava-session-facts>div{padding:14px 7px;border-bottom:1px solid var(--s-line)}.vava-session-facts span{display:block;font-size:11px;color:#938e82;margin-bottom:5px}.vava-session-facts strong{font-size:14px;color:var(--s-olive)}.vava-session-availability{display:block;margin-top:15px;padding:10px;border:1px solid rgba(98,104,64,.35);border-radius:999px;text-align:center;color:var(--s-olive);font-size:12px}
.vava-session-summary-grid{max-width:1280px;margin:34px auto 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--s-line);border-radius:28px;background:rgba(255,252,247,.65);overflow:hidden}.vava-session-summary-grid article{padding:27px;border-inline-start:1px solid var(--s-line)}.vava-session-summary-grid article:first-child{border-inline-start:0}.vava-session-summary-grid article>span{float:inline-end;font-size:25px;color:var(--s-olive)}.vava-session-summary-grid h2,.vava-session-lower-grid h2,.vava-session-faq h2{font-family:"VAVA Display","Noto Kufi Arabic",serif!important;color:var(--s-olive)!important;font-size:23px!important;margin:0 0 14px!important}.vava-session-summary-grid p,.vava-session-summary-grid li{font-size:13.5px!important;line-height:1.9!important;color:#69645a!important}.vava-session-summary-grid ul{margin:0;padding-inline-start:18px}
.vava-session-lower-grid{max-width:1280px;margin:22px auto 0;display:grid;grid-template-columns:.9fr 1.6fr;gap:20px}.vava-session-lower-grid>article{border:1px solid var(--s-line);border-radius:28px;padding:26px;background:rgba(255,252,247,.7)}.vava-session-includes>div{display:flex;gap:10px;align-items:center;padding:11px 13px;border-radius:12px;background:rgba(171,166,111,.07);margin-top:6px}.vava-session-includes span{color:var(--s-olive)}.vava-session-includes p{margin:0!important;font-size:13px!important}.vava-session-step-track{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;position:relative}.vava-session-step-track:before{content:"";position:absolute;top:18px;left:6%;right:6%;height:1px;border-top:1px dashed rgba(98,104,64,.35)}.vava-session-step-track>div{position:relative;text-align:center}.vava-session-step-track i{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--s-olive);color:#fff;margin:0 auto 12px;font-style:normal;position:relative;z-index:1}.vava-session-step-track b{display:block;color:#5b5d42;font-size:13px}.vava-session-step-track p{font-size:11.5px!important;line-height:1.7!important;color:#777166!important}
.vava-session-faq{max-width:1280px;margin:22px auto 0;border:1px solid var(--s-line);border-radius:28px;padding:26px;background:rgba(255,252,247,.7)}.vava-session-faq>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.vava-session-faq details{border:1px solid rgba(99,99,72,.12);border-radius:14px;background:#fffaf4;padding:0 14px}.vava-session-faq summary{cursor:pointer;padding:14px;font-weight:600;color:#5c5e43}.vava-session-faq details>div{padding:0 14px 14px}.vava-session-faq p{font-size:13px!important;line-height:1.8!important}
@media(max-width:1050px){.vava-session-hero{grid-template-columns:1fr 1fr}.vava-session-facts{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr)}.vava-session-facts>div{border-bottom:0;border-inline-start:1px solid var(--s-line)}.vava-session-summary-grid{grid-template-columns:repeat(2,1fr)}.vava-session-lower-grid{grid-template-columns:1fr}}
@media(max-width:700px){.vava-session-detail{padding-inline:14px}.vava-session-hero{grid-template-columns:1fr}.vava-session-hero-media{height:350px}.vava-session-facts{display:block}.vava-session-summary-grid{grid-template-columns:1fr}.vava-session-summary-grid article{border-inline-start:0;border-top:1px solid var(--s-line)}.vava-session-step-track{grid-template-columns:1fr}.vava-session-step-track:before{display:none}.vava-session-faq>div{grid-template-columns:1fr}.vava-session-btn{width:100%}}

/* V7 — bind the dynamic session template to the approved internal-page shell. */
html[data-page="comprehensive-session.html"],
html[data-page="comprehensive-session-en.html"]{overflow-x:hidden}
body.vava-session-page{overflow-x:hidden!important}
body.vava-session-page .vava-session-detail{
  width:100%;
  min-height:100vh;
  margin:0;
  overflow:hidden;
}
body.vava-session-page .vava-session-hero{
  grid-template-areas:"media copy facts";
  grid-template-columns:minmax(0,1.06fr) minmax(0,1fr) minmax(210px,.42fr);
  width:min(1280px,100%);
}
body.vava-session-page .vava-session-hero-media{grid-area:media;min-width:0}
body.vava-session-page .vava-session-hero-copy{grid-area:copy;min-width:0}
body.vava-session-page .vava-session-facts{grid-area:facts;min-width:0}
body.vava-session-page .vava-session-hero-copy h1{overflow-wrap:anywhere}
body.vava-session-page .vava-session-lead{max-width:650px}
body.vava-session-page .vava-session-lead>*:first-child{margin-top:0!important}
body.vava-session-page .vava-session-lead>*:last-child{margin-bottom:0!important}
body.vava-session-page .vava-session-summary-grid,
body.vava-session-page .vava-session-lower-grid,
body.vava-session-page .vava-session-faq{width:min(1280px,100%)}
body.vava-session-page .vava-session-summary-grid article:first-child{border-inline-start:1px solid var(--s-line)}
body.vava-session-page .vava-session-summary-grid article:last-child{border-inline-start:0}
body.vava-session-page .vava-session-step-track>div{min-width:0}
body.vava-session-page .vava-session-step-track b,
body.vava-session-page .vava-session-step-track p{overflow-wrap:anywhere}
@media(max-width:1050px){
  body.vava-session-page .vava-session-hero{
    grid-template-areas:"media copy" "facts facts";
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
  }
}
@media(max-width:700px){
  body.vava-session-page .vava-session-hero{
    grid-template-areas:"copy" "media" "facts";
    grid-template-columns:1fr;
  }
  body.vava-session-page .vava-session-summary-grid article:first-child,
  body.vava-session-page .vava-session-summary-grid article:last-child{border-inline-start:0}
}

/* V9 — icon-led olive information tiles on the approved session details design. */
body.vava-session-page .vava-session-facts{display:grid;gap:10px;padding:14px}
body.vava-session-page .vava-session-fact{
  display:grid;
  grid-template-columns:42px minmax(0,1fr);
  grid-template-rows:auto auto;
  gap:2px 10px;
  align-items:center;
  padding:12px;
  border:1px solid rgba(98,104,64,.16);
  border-radius:15px;
  background:linear-gradient(145deg,#f0f4ea,#e6eddf);
  box-shadow:0 8px 20px rgba(65,76,57,.055);
}
body.vava-session-page .vava-session-fact i{display:grid;grid-row:1/3;width:40px;height:40px;place-items:center;border-radius:12px;background:rgba(255,255,255,.72);color:var(--s-olive);font-style:normal}
body.vava-session-page .vava-session-fact i svg{width:24px;height:24px}
body.vava-session-page .vava-session-fact span{margin:0;color:#8a8f80;font-size:10px}
body.vava-session-page .vava-session-fact strong{overflow-wrap:anywhere;color:#596044;font-size:13px}
body.vava-session-page .vava-session-facts>div{border-bottom:0}
@media(max-width:1050px){
  body.vava-session-page .vava-session-facts{grid-template-columns:repeat(2,minmax(0,1fr))}
  body.vava-session-page .vava-session-availability{grid-column:1/-1}
}
@media(max-width:700px){body.vava-session-page .vava-session-facts{grid-template-columns:1fr}}
