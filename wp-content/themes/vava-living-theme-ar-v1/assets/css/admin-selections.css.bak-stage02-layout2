.vava-selections-admin .vava-selections-types-heading h3{margin:0 0 5px;color:#44513f;font-size:16px}
.vava-selections-admin .vava-selections-types-heading p{max-width:760px;margin:0;color:#6f7a70;line-height:1.7}
