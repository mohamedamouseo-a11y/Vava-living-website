.vava-selections-admin .vava-selections-type-row .vava-field,
.vava-selections-admin .vava-selections-type-row .vava-field-full{grid-column:auto;min-width:0}
.vava-selections-admin .vava-selections-type-row[data-type-field="description"] .vava-field textarea{min-height:104px}
.vava-selections-admin .vava-selections-shared-types{
  padding:18px;
  border:1px solid #eadac8;
  border-radius:16px;
  background:#fffaf4
}
.vava-selections-admin .vava-selections-shared-types>h3{margin-bottom:5px}
.vava-selections-admin .vava-selections-shared-types>.description{margin:0 0 14px;color:#7a746a;line-height:1.7}
.vava-selections-admin .vava-selections-shared-media-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.vava-selections-admin .vava-selections-shared-media-grid .vava-selections-media-field{min-width:0}
