}
.vava-selections-preview-collection:nth-child(1)>div:last-child{left:0}
.vava-selections-preview-collection:nth-child(2)>div:last-child{right:0}
.vava-selections-preview-collection h3{font-size:25px}
.vava-selections-preview-collection p{flex:1;margin-top:8px;font-size:11px;line-height:1.75}
.vava-selections-preview-collection b{align-self:flex-start;margin-top:13px;padding:9px 14px;border-radius:999px;background:#70774c;color:#fff;font-size:9px}

@media(max-width:782px){
  .vava-selections-preview-collection{min-height:220px}
  .vava-selections-preview-collection-image{width:72%;height:190px}
  .vava-selections-preview-collection>div:last-child{width:46%;min-height:158px;padding:18px}
  .vava-selections-preview-collection h3{font-size:22px}
}


/* Release 1.18.12 — digital products preview uses the approved shared cover card. */
.vava-selections-preview-products[data-preview-products="digital"]{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.vava-selections-preview-product-content{display:flex;flex-direction:column;flex:1;min-height:0}
