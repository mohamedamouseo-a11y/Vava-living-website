:root{
  --vava-admin-accent:#6f815f;
  --vava-admin-accent-soft:#edf3e9;
  --vava-admin-coral:#d9907e;
  --vava-admin-line:#dfe3e7;
  --vava-admin-bg:#f7f8fa;
  --vava-admin-text:#1f2937;
}
#poststuff #vava_homepage_settings .inside{margin:0;padding:0}
#vava_homepage_settings{border:0;box-shadow:0 1px 3px rgba(15,23,42,.08)}
#vava_homepage_settings .postbox-header{background:#fff;border-bottom:1px solid var(--vava-admin-line)}
#vava_homepage_settings .hndle{font-size:16px;padding:15px 18px}
.vava-homepage-admin{background:#fff;color:var(--vava-admin-text)}
.vava-admin-intro{display:flex;align-items:flex-start;gap:14px;margin:0;padding:16px 20px;background:#edf6ff;border-bottom:1px solid #cfe4f6}
.vava-admin-intro>.dashicons{width:36px;height:36px;font-size:26px;line-height:36px;text-align:center;color:#2271b1;background:#fff;border-radius:10px}
.vava-admin-intro strong{display:block;margin:2px 0 4px;font-size:14px}
.vava-admin-intro p{margin:0;color:#506273}
.vava-admin-toolbar{position:sticky;top:32px;z-index:20;display:flex;align-items:stretch;justify-content:space-between;gap:18px;padding:14px 18px;background:#fff;border-bottom:1px solid var(--vava-admin-line);box-shadow:0 4px 16px rgba(15,23,42,.04)}
.vava-section-tabs{display:flex;align-items:center;gap:4px;flex:1;overflow-x:auto;scrollbar-width:thin}
.vava-section-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-width:94px;padding:10px 13px;border:0;border-bottom:3px solid transparent;background:transparent;color:#4b5563;cursor:pointer;border-radius:8px 8px 0 0;transition:.18s ease}
.vava-section-tab:hover{background:#f7f8fa;color:#1f2937}
.vava-section-tab.is-active{color:var(--vava-admin-accent);background:var(--vava-admin-accent-soft);border-bottom-color:var(--vava-admin-accent);font-weight:700}
.vava-section-tab .dashicons{font-size:21px;width:22px;height:22px}
.vava-language-switch{display:flex;align-items:center;align-self:center;padding:3px;background:#eef0f2;border:1px solid #d8dde3;border-radius:10px;direction:rtl;flex:0 0 auto}
.vava-language-switch button{display:flex;align-items:center;gap:7px;padding:8px 13px;border:0;background:transparent;color:#5c6672;border-radius:7px;cursor:pointer;font-weight:600}
.vava-language-switch button small{display:inline-grid;place-items:center;min-width:25px;height:20px;padding:0 4px;border-radius:5px;background:#fff;color:#6b7280;font-size:10px}
.vava-language-switch button.is-active{background:var(--vava-admin-accent);color:#fff;box-shadow:0 2px 7px rgba(50,70,42,.2)}
.vava-language-switch button.is-active small{color:var(--vava-admin-accent)}
.vava-section-panel{display:none;padding:22px;background:var(--vava-admin-bg)}
.vava-section-panel.is-active{display:block}
.vava-panel-heading{display:flex;align-items:center;gap:13px;margin-bottom:16px;padding:17px 20px;background:#fff;border:1px solid var(--vava-admin-line);border-radius:12px}
.vava-panel-heading>.dashicons{width:42px;height:42px;font-size:24px;line-height:42px;text-align:center;color:var(--vava-admin-accent);background:var(--vava-admin-accent-soft);border-radius:10px}
.vava-panel-heading h2{margin:0 0 4px;font-size:19px}
.vava-panel-heading p{margin:0;color:#6b7280}
.vava-language-pane{display:none}
.vava-language-pane.is-active{display:block}
.vava-language-status{display:flex;align-items:center;gap:10px;margin:0 0 16px;padding:11px 14px;border:1px solid #dce8d7;background:#f3f8f0;color:#405037;border-radius:9px}
.vava-language-status small{margin-inline-start:auto;color:#68745f}
.vava-fields-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.vava-admin-field{margin:0;padding:15px;background:#fff;border:1px solid var(--vava-admin-line);border-radius:10px;box-sizing:border-box}
.vava-admin-field-textarea{grid-column:1/-1}
.vava-admin-field label{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.vava-admin-field input[type=text],.vava-admin-field input[type=url],.vava-admin-field textarea{min-height:42px;border-color:#cfd5dc;border-radius:7px;box-shadow:none}
.vava-admin-field textarea{min-height:116px;resize:vertical}
.vava-lang-badge{display:inline-flex;align-items:center;justify-content:center;min-width:27px;height:20px;padding:0 5px;border-radius:5px;background:#eef0f2;color:#5f6974;font-size:10px;font-weight:700;vertical-align:middle}
.vava-shared-fields{margin-top:18px;padding:17px;background:#fffaf3;border:1px solid #eadbc6;border-radius:11px}
.vava-shared-fields>h3,.vava-admin-repeaters>h3{display:flex;align-items:center;gap:8px;margin:0 0 14px;font-size:15px}
.vava-shared-fields>.description{margin:-5px 0 14px;color:#736a5c}
.vava-media-field{height:100%;padding:13px;border:1px dashed #bcc5ce;border-radius:9px;background:#fafbfc;box-sizing:border-box}
.vava-media-preview{display:grid;place-items:center;min-height:116px;margin:10px 0;background:#f1f3f5;border-radius:8px;color:#8b95a1;text-align:center}
.vava-media-preview .dashicons{font-size:34px;width:38px;height:38px}
.vava-media-preview em{display:block;margin-top:-30px;font-style:normal;font-size:12px}
.vava-media-preview img{display:block;max-width:100%;max-height:190px;border-radius:8px}
.vava-media-actions{display:flex;align-items:center;gap:12px;margin-top:10px}
.vava-admin-repeaters{margin-top:18px;padding:17px;background:#fff;border:1px solid var(--vava-admin-line);border-radius:11px}
.vava-repeater-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.vava-repeater-grid-three{grid-template-columns:repeat(3,minmax(0,1fr))}
.vava-repeater-grid-four{grid-template-columns:repeat(4,minmax(0,1fr))}
.vava-admin-repeater-card{margin:0;padding:14px;background:#fafafa;border:1px solid #dfe3e7;border-radius:10px;box-sizing:border-box}
.vava-admin-repeater-card h4{margin:0 0 12px;padding-bottom:9px;border-bottom:1px solid #e4e7eb;color:#4c5865}
.vava-admin-repeater-card label{display:block;margin:10px 0 5px;font-weight:600}
.vava-admin-repeater-card textarea{min-height:135px;resize:vertical}
.vava-link-card input[type=url]{direction:ltr}
.vava-toggle-row{display:flex!important;align-items:center;gap:8px;margin:0 0 12px!important}
.vava-social-card{background:#fff}
body.post-type-page.vava-homepage-classic #postdivrich{display:none!important}
@media(max-width:1200px){
  .vava-admin-toolbar{flex-direction:column;align-items:stretch}
  .vava-language-switch{align-self:flex-start}
  .vava-repeater-grid-three,.vava-repeater-grid-four{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:782px){
  .vava-admin-toolbar{top:46px;padding:10px}
  .vava-section-tab{min-width:80px;padding:8px 9px;font-size:12px}
  .vava-section-panel{padding:12px}
  .vava-fields-grid,.vava-repeater-grid,.vava-repeater-grid-three,.vava-repeater-grid-four{grid-template-columns:1fr}
  .vava-admin-field-textarea{grid-column:auto}
  .vava-language-status{align-items:flex-start;flex-wrap:wrap}
  .vava-language-status small{width:100%;margin:0}
}

/* ===== V1R4 homepage editor hardening and professional media controls ===== */
#vava_homepage_settings.vava-homepage-locked-postbox .handle-actions,
#vava_homepage_settings.vava-homepage-postbox-is-locked .handle-actions,
#vava_homepage_settings .handlediv,
#vava_homepage_settings .handle-order-higher,
#vava_homepage_settings .handle-order-lower,
#vava_homepage_settings .toggle-indicator{display:none!important}
#vava_homepage_settings .postbox-header{cursor:default!important}
#vava_homepage_settings .postbox-header>*{cursor:default!important}
#vava_homepage_settings.closed .inside{display:block!important}
body.post-type-page.vava-homepage-classic #postimagediv{display:none!important}

.vava-language-status,.vava-lang-badge{display:none!important}
.vava-admin-field-wide{grid-column:1/-1}
.vava-intro-icon,.vava-tab-icon,.vava-panel-icon{display:inline-grid;place-items:center;flex:0 0 auto}
.vava-intro-icon{width:38px;height:38px;color:#2271b1;background:#fff;border-radius:10px}
.vava-intro-icon svg{width:24px;height:24px}
.vava-tab-icon{width:25px;height:25px}
.vava-panel-icon{width:42px;height:42px;color:var(--vava-admin-accent);background:var(--vava-admin-accent-soft);border-radius:10px}
.vava-panel-icon svg{width:25px;height:25px}
.vava-intro-icon svg,.vava-tab-icon svg,.vava-panel-icon svg,.vava-link-type-switch svg,.vava-media-type-switch svg,.vava-media-empty svg{
  display:block;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round
}
.vava-panel-heading>.dashicons{display:none}
.vava-section-tab .dashicons{display:none}

.vava-admin-field select{min-height:42px;border-color:#cfd5dc;border-radius:7px;box-shadow:none}
.vava-admin-field-link label>strong{display:block}
.vava-link-type-switch,.vava-media-type-switch{display:flex;align-items:stretch;gap:10px;flex-wrap:wrap;margin:4px 0 14px}
.vava-link-type-switch label,.vava-media-type-switch label{margin:0;cursor:pointer}
.vava-link-type-switch input,.vava-media-type-switch input{position:absolute;opacity:0;pointer-events:none}
.vava-link-type-switch span,.vava-media-type-switch span{
  display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border:1px solid #cfd5dc;border-radius:9px;background:#fff;color:#4b5563;font-weight:600;transition:.16s ease
}
.vava-link-type-switch svg{width:20px;height:20px}
.vava-media-type-switch svg{width:22px;height:22px}
.vava-link-type-switch input:checked+span,.vava-media-type-switch input:checked+span{
  color:#fff;background:var(--vava-admin-accent);border-color:var(--vava-admin-accent);box-shadow:0 3px 10px rgba(73,94,62,.18)
}
.vava-link-pane{margin-top:11px}
.vava-link-pane[hidden]{display:none!important}
.vava-link-pane>label{display:block;margin:0 0 7px;color:#53606d;font-weight:600}

.vava-admin-field-media{padding:16px}
.vava-media-field{position:relative;height:auto;padding:0;border:0;background:transparent}
.vava-media-dropzone{
  position:relative;display:block;min-height:210px;border:2px dashed #b9c4ce;border-radius:13px;background:#fafcfd;outline:0;cursor:pointer;overflow:hidden;transition:border-color .18s ease,background .18s ease,box-shadow .18s ease
}
.vava-media-dropzone:hover,.vava-media-dropzone:focus,.vava-media-dropzone.is-dragover{
  border-color:var(--vava-admin-accent);background:#f3f8f0;box-shadow:0 0 0 3px rgba(111,129,95,.12)
}
.vava-media-preview{display:grid;place-items:center;align-content:center;min-height:206px;margin:0;padding:14px;background:transparent;border-radius:0;color:#76818d;box-sizing:border-box}
.vava-media-preview img,.vava-media-preview video{display:block;width:100%;max-width:100%;height:220px;max-height:220px;object-fit:contain;border-radius:9px;background:#edf0f2}
.vava-media-preview video{cursor:default}
.vava-media-empty{display:grid;place-items:center;gap:8px;text-align:center}
.vava-media-empty svg{width:50px;height:50px;color:var(--vava-admin-accent)}
.vava-media-empty strong{font-size:14px;color:#3d4854}
.vava-media-empty span{font-size:12px;color:#78838f}
.vava-media-file-name{display:block;max-width:100%;margin-top:9px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#53606d;font-size:12px}
.vava-media-actions{display:flex;align-items:center;gap:14px;margin-top:11px}
.vava-media-actions .button{min-height:34px}
.vava-upload-progress{position:absolute;inset-inline:0;bottom:0;height:4px;background:transparent;overflow:hidden}
.vava-upload-progress span{display:block;width:0;height:100%;background:var(--vava-admin-accent);transition:width .16s ease}
.vava-media-field.is-uploading .vava-media-dropzone{pointer-events:none;opacity:.75}
.vava-media-field.is-uploading .vava-upload-progress{background:#e1e6df}
.vava-media-error{margin-top:10px;padding:9px 11px;border:1px solid #e6a9a9;border-radius:7px;background:#fff1f1;color:#9c2c2c;font-size:12px}
.vava-media-field.has-error .vava-media-dropzone{border-color:#d06767}
.vava-journal-media-card .vava-admin-field{height:100%;padding:0;border:0;background:transparent}

.vava-shared-fields [data-hero-media]{display:none}
.vava-shared-fields [data-hero-media][style*="display: block"]{display:block}

@media(max-width:1200px){
  .vava-media-preview img,.vava-media-preview video{height:190px;max-height:190px}
}
@media(max-width:782px){
  .vava-admin-field-wide{grid-column:auto}
  .vava-link-type-switch,.vava-media-type-switch{display:grid;grid-template-columns:1fr 1fr}
  .vava-link-type-switch span,.vava-media-type-switch span{padding:0 10px;font-size:12px}
  .vava-media-dropzone{min-height:175px}
  .vava-media-preview{min-height:171px}
  .vava-media-preview img,.vava-media-preview video{height:165px;max-height:165px}
}

/* ===== V1R5 dynamic controls, repeaters and WordPress data sources ===== */
.vava-button-control{padding:15px 16px}
.vava-button-control-row{
  display:grid;grid-template-columns:auto minmax(180px,1fr) auto 170px minmax(240px,1.25fr);align-items:center;gap:10px 12px
}
.vava-button-control-row>label{margin:0;white-space:nowrap}
.vava-button-control-row>input,.vava-button-control-row>select,.vava-button-control-row .vava-link-pane{min-width:0;margin:0}
.vava-button-control-row .vava-link-pane{width:100%}
.vava-button-control-row .vava-link-pane input,.vava-button-control-row .vava-link-pane select{width:100%;min-height:42px}
.vava-link-pane[hidden],[data-journal-pane][hidden]{display:none!important}

.vava-hero-media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:16px}
.vava-hero-media-grid .vava-admin-field-wide{grid-column:auto}
.vava-hero-media-grid [data-hero-media="image"]{grid-column:1/-1}
.vava-hero-media-grid [data-hero-media]{display:none}
.vava-hero-media-grid[data-active-media="image"] [data-hero-media="image"],
.vava-hero-media-grid[data-active-media="video"] [data-hero-media="video"]{display:block}

.vava-repeater-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 0 14px}
.vava-repeater-heading h3{margin:0;font-size:15px}
.vava-repeater-heading .description{margin:5px 0 0;color:#6b7280}
.vava-repeater-list{display:grid;gap:12px}
.vava-repeater-item{margin:0;border:1px solid #dfe3e7;border-radius:10px;background:#fafafa;overflow:hidden;box-sizing:border-box}
.vava-repeater-item-header{display:flex;align-items:center;gap:10px;min-height:48px;padding:8px 12px;background:#f4f6f7;border-bottom:1px solid #e1e5e8}
.vava-repeater-item-header strong{color:#46515d}
.vava-repeater-actions{display:flex;align-items:center;gap:13px;margin-inline-start:auto}
.vava-repeater-drag{display:inline-grid;place-items:center;width:30px;height:30px;padding:0;border:0;background:transparent;color:#7a8590;cursor:grab;font-size:17px;line-height:1}
.vava-repeater-drag:active{cursor:grabbing}
.vava-repeater-item-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:14px}
.vava-repeater-field label{display:block;margin:0 0 6px;font-weight:600}
.vava-repeater-field textarea{min-height:132px;resize:vertical}
.vava-repeater-field-wide{grid-column:1/-1}
.vava-repeater-field-grow{min-width:0}
.vava-repeater-item.is-collapsed .vava-repeater-item-header{border-bottom:0}
.vava-repeater-placeholder{height:70px;border:2px dashed #b9c4ce;border-radius:10px;background:#f3f8f0}
.vava-social-platform-icon{display:inline-grid;place-items:center;width:32px;height:32px;color:var(--vava-admin-accent);background:#fff;border:1px solid #dfe3e7;border-radius:8px}
.vava-social-platform-icon svg{display:block;width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
.vava-social-fields{grid-template-columns:minmax(180px,.7fr) minmax(260px,1.3fr)}

.vava-journal-query>.description{margin:-5px 0 14px;color:#6b7280}
.vava-journal-query-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.vava-journal-query-grid>.vava-admin-field:first-child{grid-column:1/-1}
.vava-multiple-select{min-height:150px!important;padding:5px!important}
.vava-multiple-select option{padding:6px 8px}

.vava-document-control-row{display:grid;grid-template-columns:auto minmax(180px,1fr) auto minmax(170px,.7fr);align-items:center;gap:10px 12px}
.vava-document-control-row>label{margin:0;white-space:nowrap}
.vava-footer-menu-field .description{margin:8px 0 0}
.vava-footer-menu-field .description a{text-decoration:none}

@media(max-width:1200px){
  .vava-button-control-row{grid-template-columns:auto minmax(180px,1fr) auto 160px}
  .vava-button-control-row .vava-link-pane{grid-column:1/-1}
}
@media(max-width:900px){
  .vava-hero-media-grid,.vava-journal-query-grid{grid-template-columns:1fr}
  .vava-hero-media-grid [data-hero-media="image"],.vava-journal-query-grid>.vava-admin-field:first-child{grid-column:auto}
  .vava-document-control-row{grid-template-columns:auto minmax(0,1fr)}
  .vava-social-fields{grid-template-columns:1fr}
}
@media(max-width:782px){
  .vava-button-control-row{grid-template-columns:1fr}
  .vava-button-control-row>label{margin-top:5px}
  .vava-button-control-row .vava-link-pane{grid-column:auto}
  .vava-repeater-heading{align-items:flex-start;flex-direction:column}
  .vava-repeater-item-body{grid-template-columns:1fr}
  .vava-repeater-field-wide{grid-column:auto}
  .vava-document-control-row{grid-template-columns:1fr}
}


/* ===== V1R6 live section previews ===== */
.vava-editor-workspace{display:grid;grid-template-columns:minmax(320px,.82fr) minmax(0,1.5fr);gap:18px;align-items:start}
.vava-editor-controls{min-width:0}
.vava-live-preview{position:sticky;top:148px;min-width:0;border:1px solid var(--vava-admin-line);border-radius:14px;background:#fff;box-shadow:0 8px 28px rgba(15,23,42,.07);overflow:hidden}
.vava-live-preview-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border-bottom:1px solid #e5e8eb;background:#fbfcfc}
.vava-live-preview-header>div{display:grid;gap:2px}
.vava-live-preview-header strong{font-size:13px;color:#34404c}
.vava-live-preview-header span{font-size:11px;color:#7a8590}
.vava-live-preview-dot{width:8px;height:8px;border-radius:50%;background:#6f815f;box-shadow:0 0 0 4px rgba(111,129,95,.12)}
.vava-preview-canvas{position:relative;min-height:470px;overflow:hidden;background:#f5f1e9;color:#2c352d;box-sizing:border-box}
.vava-preview-canvas h3,.vava-preview-canvas h4,.vava-preview-canvas p,.vava-preview-canvas small{margin-top:0}
.vava-preview-canvas [data-preview-output]{white-space:pre-line}
.vava-preview-canvas a{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 16px;border-radius:999px;text-decoration:none;font-weight:700;pointer-events:none}
.vava-preview-kicker{display:block;margin-bottom:8px;color:#6f815f;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.vava-preview-empty{grid-column:1/-1;padding:28px 14px;border:1px dashed #c8ced4;border-radius:10px;color:#78838f;text-align:center;background:rgba(255,255,255,.58)}

.vava-preview-hero{min-height:520px;background:#273128;color:#fff}
.vava-preview-hero-media,.vava-preview-hero-media img,.vava-preview-hero-media video,.vava-preview-overlay{position:absolute;inset:0;width:100%;height:100%}
.vava-preview-hero-media img,.vava-preview-hero-media video{object-fit:cover}
.vava-preview-hero-media[data-preview-hero-type="image"] video,.vava-preview-hero-media[data-preview-hero-type="video"] img{display:none}
.vava-preview-overlay{background:linear-gradient(90deg,rgba(25,31,26,.82),rgba(25,31,26,.25) 70%,rgba(25,31,26,.08))}
.vava-preview-hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:520px;padding:34px;box-sizing:border-box}
.vava-preview-hero-copy>span{margin-bottom:12px;font-size:11px;letter-spacing:.2em;text-transform:uppercase}
.vava-preview-hero-copy h3{max-width:320px;margin-bottom:14px;font-size:31px;line-height:1.25;color:#fff}
.vava-preview-hero-copy p{max-width:360px;margin-bottom:20px;font-size:13px;line-height:1.9;color:rgba(255,255,255,.88)}
.vava-preview-hero-copy a{background:#e1b8a2;color:#2f342f}

